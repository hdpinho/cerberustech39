# Copia este archivo a .env.local y completa lo que necesites.
# Ninguna de estas variables es secreta: todas llegan al navegador (NEXT_PUBLIC_).
# No guardes claves privadas en este proyecto.

# URL pública del sitio (canónicas, sitemap, Open Graph). Opcional: en Vercel se usa sola
# la URL de producción del proyecto; fuera de Vercel, el `dominio` de content/config.ts.
NEXT_PUBLIC_SITE_URL=

# Endpoint del formulario (Formspree, plan gratuito). Ej.: https://formspree.io/f/abcdwxyz
# Si está vacío, se usa content/config.ts → formEndpoint. Si ambos están vacíos,
# el formulario no se publica y se muestran WhatsApp y correo.
NEXT_PUBLIC_FORM_ENDPOINT=

# Analítica respetuosa con la privacidad (desactivada por defecto).
# Valores: "" | plausible | umami
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
